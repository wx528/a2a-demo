# A2A Agent Swarm 环境变量示例
# 复制为 .env 后填入真实值即可使用：
# - 本地裸跑（python xxx/main.py）：服务启动时自动加载根目录 .env
#   （已 export 的环境变量优先于 .env）
# - docker compose：通过变量替换自动读取
# - GitHub Actions：走仓库 Secrets，不读本文件

# ===========================================
# LLM 配置（可选但推荐）
# 支持所有 OpenAI 兼容 API
# ===========================================

# API Key，大部分服务商都需要
LLM_API_KEY=your-api-key-here

# 基础 URL，OpenAI 兼容服务的 endpoint
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
LLM_MODEL=gpt-4o-mini


# ===========================================
# 常用服务商配置示例（取消对应注释即可使用）
# ===========================================

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

# --- SiliconFlow ---
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- 本地 Ollama ---
# 注意：Docker 容器内访问宿主机用 host.docker.internal
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama  # Ollama 可随便填


# ===========================================
# 服务端口配置（一般不需要改）
# ===========================================

# ORCHESTRATOR_PORT=8000
# RESEARCH_AGENT_PORT=8001
# WRITING_AGENT_PORT=8002

# ===========================================
# 任务持久化（可选）
# 设置后 agent 任务落 SQLite，重启不丢；
# docker compose 已默认启用（容器内 /data/tasks.db + named volume）
# 本地运行示例：TASK_DB=./data/research.db
# ===========================================
# TASK_DB=./data/tasks.db

# ===========================================
# Orchestrator 动态发现（可选）
# 逗号分隔的 agent 地址列表；新增 agent 填这里即可，
# 不填则回退 RESEARCH_AGENT_URL / WRITING_AGENT_URL
# ===========================================
# AGENT_URLS=http://localhost:8001,http://localhost:8002

# ===========================================
# Web 会议室（可选）
# 辩论模式连接的 debate-agent 地址
# ===========================================
# DEBATE_AGENT_URL=http://localhost:8003

# ===========================================
# 安全配置（可选，推荐公网/局域网部署时开启）
# ===========================================

# A2A API Key：设置后所有 agent 的 /rpc、/rpc/stream 与 orchestrator
# 的写操作要求 `Authorization: Bearer <key>` 或 `X-API-Key: <key>`；
# 内部互调（web/orchestrator → agent）会自动附带该 key。
# 留空 = 不鉴权（仅建议本机回环使用）。
# A2A_API_KEY=change-me

# 监听接口：本地裸跑默认 127.0.0.1（只听回环）；
# docker compose 已为每个服务显式设置 BIND_HOST=0.0.0.0（容器端口映射需要）。
# 本地想让局域网访问时才改为 0.0.0.0。
# BIND_HOST=127.0.0.1

# ===========================================
# 辩论 Agent 搜索配置（可选）
# 默认 DuckDuckGo 无需 key；Tavily 需要申请 https://tavily.com
# ===========================================
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=tvly-...
# SEARCH_MAX_RESULTS=5
